const express = require("express");
const { Pool } = require("pg");

const app = express();
app.use(express.json());

// PostgreSQL Database Connection
const pool = new Pool({
    host: "localhost",
    user: "postgres",
    password: "password",
    database: "studentdb",
    port: 5432
});
// Login API
app.post("/login", async (req, res) => {

    const { username, password } = req.body;

    try {
        const result = await pool.query(
            "SELECT * FROM users WHERE username = $1 AND password = $2",
            [username, password]
        );

        if (result.rows.length > 0) {
            res.status(200).json({ message: "Login Successful" });
        } else {
            res.status(401).json({ message: "Invalid Username or Password" });
        }

    } catch (err) {
        console.log(err);
        res.status(500).json({ message: "Database Error" });
    }
});

// Signup API
app.post("/signup", async (req, res) => {

    const { username, password } = req.body;

    try {

        // Check if username already exists
        const checkUser = await pool.query(
            "SELECT * FROM users WHERE username = $1",
            [username]
        );

        if (checkUser.rows.length > 0) {
            return res.status(400).json({
                message: "Username already exists"
            });
        }

        // Insert new user
        await pool.query(
            "INSERT INTO users (username, password) VALUES ($1, $2)",
            [username, password]
        );

        res.status(201).json({
            message: "Signup Successful"
        });

    } catch (err) {
        console.log(err);

        res.status(500).json({
            message: "Database Error"
        });

    }

});

// Save Project API
app.post("/saveProject", async (req, res) => {

    const { project_name, description, created_by } = req.body;

    try {
        await pool.query(
            "INSERT INTO projects (project_name, description, created_by) VALUES ($1, $2, $3)",
            [project_name, description, created_by]
        );

        res.status(201).json({
            message: "Project Saved Successfully"
        });

    } catch (err) {
        console.log(err);
        res.status(500).json({
            message: "Database Error"
        });
    }
});

// Load Project API
app.get("/loadProject", async (req, res) => {

    try {

        const result = await pool.query("SELECT * FROM projects");

        res.status(200).json(result.rows);

    } catch (err) {
        console.log(err);
        res.status(500).json({
            message: "Database Error"
        });

    }

});

// Update Project API
app.put("/updateProject/:id", async (req, res) => {

    const { id } = req.params;
    const { project_name, description, created_by } = req.body;

    try {

        const result = await pool.query(
            `UPDATE projects
             SET project_name = $1,
                 description = $2,
                 created_by = $3
             WHERE id = $4`,
            [project_name, description, created_by, id]
        );

        if (result.rowCount === 0) {
            return res.status(404).json({
                message: "Project not found"
            });
        }

        res.status(200).json({
            message: "Project Updated Successfully"
        });

    } catch (err) {

        console.error(err);
        res.status(500).json({
            message: err.message
        });

    }

});

// Delete Project API
app.delete("/deleteProjects", async (req, res) => {

    const { ids } = req.body;

    try {

        const result = await pool.query(
            "DELETE FROM projects WHERE id = ANY($1)",
            [ids]
        );

        if (result.rowCount === 0) {
            return res.status(404).json({
                message: "Project not found"
            });
        }

        res.status(200).json({
            message: "Project Deleted Successfully"
        });

    } catch (err) {
